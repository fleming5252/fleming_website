# ============================================================
#  Fleming Embedded & Software Solutions
#  Production .htaccess — Apache 2.4+
#  https://www.fleming.co.in
# ============================================================

# ─── PERFORMANCE: Compression ──────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html
  AddOutputFilterByType BROTLI_COMPRESS text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript
  AddOutputFilterByType BROTLI_COMPRESS text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/plain
  AddOutputFilterByType BROTLI_COMPRESS application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json
  AddOutputFilterByType BROTLI_COMPRESS application/ld+json
  AddOutputFilterByType BROTLI_COMPRESS application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS application/atom+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/ttf
  AddOutputFilterByType BROTLI_COMPRESS font/otf
  AddOutputFilterByType BROTLI_COMPRESS font/woff
  AddOutputFilterByType BROTLI_COMPRESS font/woff2
  AddOutputFilterByType BROTLI_COMPRESS application/vnd.ms-fontobject
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ─── PERFORMANCE: Browser Caching ──────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — no cache (always fresh)
  ExpiresByType text/html                         "access plus 0 seconds"

  # CSS & JavaScript
  ExpiresByType text/css                          "access plus 1 year"
  ExpiresByType text/javascript                   "access plus 1 year"
  ExpiresByType application/javascript            "access plus 1 year"
  ExpiresByType application/x-javascript          "access plus 1 year"

  # Images
  ExpiresByType image/jpeg                        "access plus 1 year"
  ExpiresByType image/png                         "access plus 1 year"
  ExpiresByType image/gif                         "access plus 1 year"
  ExpiresByType image/webp                        "access plus 1 year"
  ExpiresByType image/avif                        "access plus 1 year"
  ExpiresByType image/svg+xml                     "access plus 1 year"
  ExpiresByType image/x-icon                      "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon          "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf                          "access plus 1 year"
  ExpiresByType font/otf                          "access plus 1 year"
  ExpiresByType font/woff                         "access plus 1 year"
  ExpiresByType font/woff2                        "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject     "access plus 1 year"

  # Video
  ExpiresByType video/mp4                         "access plus 1 year"
  ExpiresByType video/webm                        "access plus 1 year"

  # Data — no cache
  ExpiresByType application/json                  "access plus 0 seconds"
  ExpiresByType application/ld+json               "access plus 0 seconds"
  ExpiresByType application/xml                   "access plus 0 seconds"
  ExpiresByType text/xml                          "access plus 0 seconds"
</IfModule>

# ─── PERFORMANCE: Cache Control Headers ────────────────────
<IfModule mod_headers.c>
  # Static assets — aggressive caching
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf|eot|svg|webp|avif|png|jpe?g|gif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — revalidate every time
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # JSON / XML — no cache
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── SECURITY: Directory & Access Controls ─────────────────
Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "^(web\.config|\.htaccess|\.htpasswd)$">
  Require all denied
</FilesMatch>

# ─── SECURITY: Response Headers ────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── ERROR DOCUMENTS ───────────────────────────────────────
# Custom 404 page — Apache serves /404.html with a true HTTP 404 status.
# Absolute path (/404.html) ensures correct resolution regardless of the
# requested URI.  Placed outside the RewriteBlock so it is evaluated by
# Apache after mod_rewrite exhausts all rules without a match.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ─── Canonical redirects: .html → clean URL ───────────
    # Must run BEFORE the skip-existing block, otherwise the real
    # .html file matches first and the redirect never fires.
    RewriteCond %{THE_REQUEST} \s/employee-attendance-and-payroll-software\.html[\s?] [NC]
    RewriteRule ^employee-attendance-and-payroll-software\.html$ /employee-attendance-and-payroll-software [R=301,L]

    RewriteCond %{THE_REQUEST} \s/fruit-inventory-management-software\.html[\s?] [NC]
    RewriteRule ^fruit-inventory-management-software\.html$ /fruit-inventory-management-software [R=301,L]

    RewriteCond %{THE_REQUEST} \s/payroll-management\.html[\s?] [NC]
    RewriteRule ^payroll-management\.html$ /payroll-management [R=301,L]

    RewriteCond %{THE_REQUEST} \s/educational-institution-management\.html[\s?] [NC]
    RewriteRule ^educational-institution-management\.html$ /educational-institution-management [R=301,L]

    RewriteCond %{THE_REQUEST} \s/newspaper-billing-software\.html[\s?] [NC]
    RewriteRule ^newspaper-billing-software\.html$ /newspaper-billing-software [R=301,L]

    RewriteCond %{THE_REQUEST} \s/e-learning-management\.html[\s?] [NC]
    RewriteRule ^e-learning-management\.html$ /e-learning-management [R=301,L]

    RewriteCond %{THE_REQUEST} \s/ecommerce-management\.html[\s?] [NC]
    RewriteRule ^ecommerce-management\.html$ /ecommerce-management [R=301,L]

    RewriteCond %{THE_REQUEST} \s/distribution-inventory-management\.html[\s?] [NC]
    RewriteRule ^distribution-inventory-management\.html$ /distribution-inventory-management [R=301,L]

    RewriteCond %{THE_REQUEST} \s/about\.html[\s?] [NC]
    RewriteRule ^about\.html$ /about [R=301,L]

    RewriteCond %{THE_REQUEST} \s/services\.html[\s?] [NC]
    RewriteRule ^services\.html$ /services [R=301,L]

    RewriteCond %{THE_REQUEST} \s/products\.html[\s?] [NC]
    RewriteRule ^products\.html$ /products [R=301,L]

    RewriteCond %{THE_REQUEST} \s/contact\.html[\s?] [NC]
    RewriteRule ^contact\.html$ /contact [R=301,L]

    RewriteCond %{THE_REQUEST} \s/privacy-policy\.html[\s?] [NC]
    RewriteRule ^privacy-policy\.html$ /privacy-policy [R=301,L]

    RewriteCond %{THE_REQUEST} \s/techno\.html[\s?] [NC]
    RewriteRule ^techno\.html$ /techno-solutions [R=301,L]

    RewriteCond %{THE_REQUEST} \s/techno_services\.html[\s?] [NC]
    RewriteRule ^techno_services\.html$ /techno-solutions/services [R=301,L]

    RewriteCond %{THE_REQUEST} \s/techno_rd\.html[\s?] [NC]
    RewriteRule ^techno_rd\.html$ /techno-solutions/research [R=301,L]

    RewriteCond %{THE_REQUEST} \s/techno_careers\.html[\s?] [NC]
    RewriteRule ^techno_careers\.html$ /techno-solutions/careers [R=301,L]

    RewriteCond %{THE_REQUEST} \s/techno_contact\.html[\s?] [NC]
    RewriteRule ^techno_contact\.html$ /techno-solutions/contact [R=301,L]

    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Legacy canonical slugs → current clean URLs
    RewriteRule ^fruit-inventory-distribution-software/?$ /fruit-inventory-management-software [R=301,L]
    RewriteRule ^payroll-management-software/?$ /payroll-management [R=301,L]
    RewriteRule ^education-erp-management-software/?$ /educational-institution-management [R=301,L]

    # Skip existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URLs
    RewriteRule ^about/?$ about.html [L]
    RewriteRule ^services/?$ services.html [L]
    RewriteRule ^products/?$ products.html [L]
    RewriteRule ^contact/?$ contact.html [L]
    RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
    RewriteRule ^employee-attendance-and-payroll-software/?$ employee-attendance-and-payroll-software.html [L]
    RewriteRule ^fruit-inventory-management-software/?$ fruit-inventory-management-software.html [L]
    RewriteRule ^payroll-management/?$ payroll-management.html [L]
    RewriteRule ^educational-institution-management/?$ educational-institution-management.html [L]
    RewriteRule ^newspaper-billing-software/?$ newspaper-billing-software.html [L]
    RewriteRule ^e-learning-management/?$ e-learning-management.html [L]
    RewriteRule ^ecommerce-management/?$ ecommerce-management.html [L]
    RewriteRule ^distribution-inventory-management/?$ distribution-inventory-management.html [L]

    RewriteRule ^techno-solutions/?$ techno.html [L]
    RewriteRule ^techno-solutions/services/?$ techno_services.html [L]
    RewriteRule ^techno-solutions/research/?$ techno_rd.html [L]
    RewriteRule ^techno-solutions/careers/?$ techno_careers.html [L]
    RewriteRule ^techno-solutions/contact/?$ techno_contact.html [L]
</IfModule>